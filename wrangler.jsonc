{
  "name": "abhimanyu",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "observability": { "enabled": false },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
}
